@prefix cso: <http://example.org/csoplus#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/csoplus> a owl:Ontology ; rdfs:label "CSO+ (thesis ontology)" .

cso:CloudAsset a owl:Class ; rdfs:comment "theme: core" .
cso:Threat a owl:Class ; rdfs:comment "theme: core" .
cso:AttackTechnique a owl:Class ; rdfs:subClassOf cso:Threat ; rdfs:comment "theme: core" .
cso:NetworkEntity a owl:Class ; rdfs:comment "theme: core" .
cso:Control a owl:Class ; rdfs:comment "theme: core" .
cso:Tenant a owl:Class ; rdfs:comment "theme: core" .
cso:Port a owl:Class ; rdfs:subClassOf cso:NetworkEntity ; rdfs:comment "theme: network" .
cso:PortRange a owl:Class ; rdfs:subClassOf cso:NetworkEntity ; rdfs:comment "theme: network" .
cso:Protocol a owl:Class ; rdfs:subClassOf cso:NetworkEntity ; rdfs:comment "theme: network" .
cso:Service a owl:Class ; rdfs:subClassOf cso:NetworkEntity ; rdfs:comment "theme: network" .
cso:Container a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: containerisation" .
cso:Pod a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: containerisation" .
cso:Deployment a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: containerisation" .
cso:DaemonSet a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: containerisation" .
cso:Sidecar a owl:Class ; rdfs:subClassOf cso:Container ; rdfs:comment "theme: containerisation" .
cso:ContainerRegistry a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: containerisation" .
cso:KubernetesAPIServer a owl:Class ; rdfs:subClassOf cso:Service ; rdfs:comment "theme: containerisation" .
cso:Kubelet a owl:Class ; rdfs:subClassOf cso:Service ; rdfs:comment "theme: containerisation" .
cso:Function a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: serverless" .
cso:FunctionInvocation a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: serverless" .
cso:EventTrigger a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: serverless" .
cso:WorkflowOrchestrator a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: serverless" .
cso:APIGateway a owl:Class ; rdfs:subClassOf cso:Service ; rdfs:comment "theme: serverless" .
cso:ObjectStorageBucket a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: serverless" .
cso:ServiceMesh a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: mesh" .
cso:VirtualService a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: mesh" .
cso:IngressController a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: mesh" .
cso:NetworkPolicy a owl:Class ; rdfs:subClassOf cso:Control ; rdfs:comment "theme: mesh" .
cso:LoadBalancer a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: mesh" .
cso:VirtualNetwork a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: mesh" .
cso:IAMRole a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: identity" .
cso:ServiceAccount a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: identity" .
cso:TenantBoundary a owl:Class ; rdfs:subClassOf cso:Control ; rdfs:comment "theme: identity" .
cso:CrossTenantFlow a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: identity" .
cso:AccessKey a owl:Class ; rdfs:subClassOf cso:CloudAsset ; rdfs:comment "theme: identity" .
cso:ContainerEscape a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: cloud_attacks" .
cso:SupplyChainCompromise a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: cloud_attacks" .
cso:PrivilegeEscalation a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: cloud_attacks" .
cso:Cryptojacking a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: cloud_attacks" .
cso:LateralMovement a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: cloud_attacks" .
cso:DataExfiltration a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: cloud_attacks" .
cso:ExposedAPIExploit a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: cloud_attacks" .
cso:Reconnaissance a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: network_attacks" .
cso:BruteForce a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: network_attacks" .
cso:DenialOfService a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: network_attacks" .
cso:WebAttack a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: network_attacks" .
cso:CommandAndControl a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: network_attacks" .
cso:ProtocolExploit a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: network_attacks" .
cso:DataExposure a owl:Class ; rdfs:subClassOf cso:AttackTechnique ; rdfs:comment "theme: network_attacks" .
cso:usesProtocol a owl:ObjectProperty ; rdfs:domain cso:Service ; rdfs:range cso:Protocol .
cso:listensOn a owl:ObjectProperty ; rdfs:domain cso:Service ; rdfs:range cso:Port .
cso:inRange a owl:ObjectProperty ; rdfs:domain cso:Port ; rdfs:range cso:PortRange .
cso:commonlyAbusedFor a owl:ObjectProperty ; rdfs:domain cso:Port ; rdfs:range cso:AttackTechnique .
cso:targetsService a owl:ObjectProperty ; rdfs:domain cso:AttackTechnique ; rdfs:range cso:Service .
cso:enablesLateralMovement a owl:ObjectProperty ; rdfs:domain cso:Service ; rdfs:range cso:LateralMovement .
cso:mitigatedBy a owl:ObjectProperty ; rdfs:domain cso:AttackTechnique ; rdfs:range cso:Control .
cso:isPartOf a owl:ObjectProperty ; rdfs:domain cso:CloudAsset ; rdfs:range cso:CloudAsset .
cso:runsOn a owl:ObjectProperty ; rdfs:domain cso:Container ; rdfs:range cso:CloudAsset .
cso:assumesRole a owl:ObjectProperty ; rdfs:domain cso:ServiceAccount ; rdfs:range cso:IAMRole .
cso:invokes a owl:ObjectProperty ; rdfs:domain cso:EventTrigger ; rdfs:range cso:Function .
cso:routesTo a owl:ObjectProperty ; rdfs:domain cso:IngressController ; rdfs:range cso:Service .
cso:governs a owl:ObjectProperty ; rdfs:domain cso:NetworkPolicy ; rdfs:range cso:Pod .
cso:crossesBoundary a owl:ObjectProperty ; rdfs:domain cso:CrossTenantFlow ; rdfs:range cso:TenantBoundary .
cso:exposes a owl:ObjectProperty ; rdfs:domain cso:CloudAsset ; rdfs:range cso:Service .
cso:authenticatesWith a owl:ObjectProperty ; rdfs:domain cso:Service ; rdfs:range cso:AccessKey .
cso:storesDataIn a owl:ObjectProperty ; rdfs:domain cso:Function ; rdfs:range cso:ObjectStorageBucket .
cso:escalatesTo a owl:ObjectProperty ; rdfs:domain cso:AttackTechnique ; rdfs:range cso:AttackTechnique .
cso:precedes a owl:ObjectProperty ; rdfs:domain cso:AttackTechnique ; rdfs:range cso:AttackTechnique .
cso:protectedBy a owl:ObjectProperty ; rdfs:domain cso:Service ; rdfs:range cso:Control .
cso:WellKnownRange a owl:NamedIndividual, cso:PortRange .
cso:RegisteredRange a owl:NamedIndividual, cso:PortRange .
cso:DynamicRange a owl:NamedIndividual, cso:PortRange .
